   "category": {
    "label": "Category",
    "plural": "Categories",
    "match": {
     "tier": 2,
     "minLength": 3
    }
   },
   "material": {
    "label": "Material",
    "plural": "Materials",
    "destination": false,
    "match": {
     "tier": 3,
     "mode": "phrase"
    }
   },
   "topic": {
    "destination": false,
    "match": {
     "skip": true
    }
   }
  },
  "kinds": {
   "made-by": {
    "label": "made by",
