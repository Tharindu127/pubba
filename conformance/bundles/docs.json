   "same-concepts": {
    "label": "covers the same concepts as",
    "pull": 0.9
   },
   "mentions": {
    "label": "mentions",
    "pull": 0.5
   }
  },
  "match": {
   "typoMinLength": 5,
   "distinctWords": true,
   "precise": true,
   "stopWords": [
    "the",
    "a",
    "how",
    "to",
    "guide",
    "page"
   ]
  },
  "templates": {
   "explains": {
    "out": "{item} explains {other}.",
    "in": "{item} is explained in {other}."
   },
   "uses-api": {
    "out": "{item} uses {other}.",
    "in": "{item} is used in {other}."
   },
   "see-also": "See also {item}.",
   "same-concepts": "{item} covers the same concepts as {other}[ ({via})].",
   "since": "{item} is new in {other}."
  }
