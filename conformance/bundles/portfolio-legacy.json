    "pull": 1
   },
   "built-with": {
    "label": "built with",
    "pull": 0.9
   },
   "shipped-in": {
    "label": "shipped in",
    "pull": 0.9
   },
   "made-at": {
    "label": "made at",
    "pull": 0.8
   },
   "used-with": {
    "label": "used with",
    "pull": 0.8
   },
   "used-at": {
    "label": "used at",
    "pull": 0.6
   },
   "about": {
    "label": "about",
    "pull": 0.75
   },
   "runs-on": {
    "label": "runs on",
    "pull": 0.55
   },
   "worked-as": {
    "label": "worked as",
    "pull": 0.7
   },
   "founded": {
    "label": "founded",
    "pull": 0.8
   },
   "mentions": {
    "label": "mentions",
    "pull": 0.5
   }
  },
  "next": {
   "recency": 0.6,
   "secondStep": 0.4,
   "sections": {
    "projects": "project",
    "skills": "tech",
    "reach": "market",
    "experience": "role",
    "games": "game",
    "creative": "creative"
