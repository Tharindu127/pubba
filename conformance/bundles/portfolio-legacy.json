    "Nimali"
   ],
   "notHere": [
    "React Native Web"
   ]
  },
  "templates": {
   "section": "{item} is worth a look.",
   "section.game": "{item} is one they play.",
   "same-stack": "{item} is built on the same stack as {other}[ ({via})].",
   "same-series": "{item} is from the same series as {other}.",
   "built-with": {
    "out": "{item} is built with {other}.",
    "in": "{item} is part of {other}'s stack."
   },
   "shipped-in": {
    "out": "{item} shipped in {other} too.",
    "in": "{item} is where {other} shipped."
   },
   "made-at": {
    "cases": [
     {
      "item": "role",
      "text": "As {item}, they built {other}."
     }
    ],
    "default": "{item} is what they built as {other}."
   },
   "used-with": "{item} goes with {other}[, as in {via}].",
   "used-at": {
    "cases": [
     {
      "item": "role",
      "text": "As {item}, they worked with {other}."
     }
    ],
    "default": "{item} was part of their work as {other}."
   },
   "about": "{item} is about {otherLower} too.",
   "runs-on": "{item} is on {other} as well.",
   "worked-as": "{item} is one of their roles.",
   "founded": "{item} is one of their own ventures.",
   "mentions": {
    "cases": [
     {
      "item": "role",
      "other": "market",
      "text": "As {item}, they shipped to {other}."
     },
     {
      "item": "market",
      "other": "role",
      "text": "{item} is where they shipped as {other}."
     }
    ],
    "out": "{item} mentions {other}.",
    "in": "{other} mentions {item}."
   }
  }
