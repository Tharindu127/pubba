{
  "preset": "none",
  "config": {
    "types": {
      "course": { "label": "Course", "plural": "Courses", "match": { "tier": 1, "firstWord": true }, "similar": ["same-topics", "same-series"] },
      "instructor": { "label": "Instructor", "plural": "Instructors", "match": { "tier": 2, "minLength": 3, "firstWord": true } },
      "level": { "label": "Level", "plural": "Levels", "destination": false, "match": { "skip": true } },
      "topic": { "label": "Topic", "plural": "Topics", "match": { "tier": 3, "mode": "phrase" } }
    },
    "kinds": {
      "about": { "label": "about", "pull": 0.8, "weightFrom": "to", "weight": 0.7 },
      "taught-by": { "label": "taught by", "pull": 0.7, "weight": 1 },
      "at-level": { "label": "at", "pull": 0.4, "weight": 0.5 },
      "prerequisite": { "label": "needs", "pull": 0.9, "weight": 1 },
      "same-series": { "label": "same series as", "pull": 1 },
      "same-topics": { "label": "covers the same as", "pull": 1 },
      "taught-together": { "label": "taught together with", "pull": 0.6 }
    },
    "rules": [
      { "type": "label-prefix", "kind": "same-series", "among": "course", "weight": 1, "stems": true },
      { "type": "shared", "kind": "same-topics", "among": "course", "through": ["about"], "minWeight": 1, "min": 2, "base": 0.4 },
      { "type": "co-occur", "kind": "taught-together", "among": "topic", "through": ["about"], "minWeight": 0.7, "min": 2, "saturate": 3 }
    ],
    "match": { "typoMinLength": 4, "partialWords": true, "ignore": ["Academy"], "similarPattern": "\\b(like|similar|instead of)\\b" },
    "templates": {
      "about": { "out": "{item} covers {other}.", "in": "{item} is taught in {other}." },
      "taught-by": { "out": "{item} is taught by {other}.", "in": "{item} teaches {other}." },
      "prerequisite": { "out": "{item} needs {other} first.", "in": "{item} leads on to {other}." },
      "same-series": "{item} is part of the same series as {other}.",
      "same-topics": "{item} covers the same ground as {other}[ ({via})].",
      "taught-together": "{item} is often taught with {other}."
    },
    "next": { "recency": 0.5, "secondStep": 0.5, "hubDamping": 2 }
  },
