{
  "preset": "none",
  "config": {
    "types": {
      "product": {
        "label": "Product",
        "plural": "Products",
        "match": {
          "tier": 1,
          "firstWord": true
        },
        "similar": [
          "goes-with"
        ]
      },
      "brand": {
        "label": "Brand",
        "plural": "Brands",
        "match": {
          "tier": 2,
          "minLength": 3
        },
        "similar": false
      },
      "category": {
        "label": "Category",
        "plural": "Categories",
        "match": {
          "tier": 2,
          "minLength": 3
        },
        "similar": false
      },
      "material": {
        "label": "Material",
        "plural": "Materials",
        "destination": false,
        "match": {
          "tier": 3,
          "mode": "phrase"
        }
      },
      "topic": {
        "destination": false,
        "match": {
          "skip": true
        }
      }
    },
    "kinds": {
      "made-by": {
        "label": "made by",
        "pull": 0.8,
        "weight": 1
      },
      "in-category": {
        "label": "in",
        "pull": 0.6,
        "weight": 0.6
      },
      "made-of": {
        "label": "made of",
        "pull": 0.5,
        "weightFrom": "to",
        "weight": 0.7
      },
      "goes-with": {
        "label": "goes with",
        "pull": 1
      },
      "same-collection": {
        "label": "same collection as",
        "pull": 1
      },
      "paired": {
        "label": "paired with",
        "pull": 0.4
      },
      "about": {
        "label": "about",
        "pull": 0.7,
        "weight": 0.7
      },
      "mentions": {
        "label": "mentions",
        "pull": 0.5,
        "weight": 0.5
      }
    },
    "rules": [
      {
        "type": "label-prefix",
        "kind": "same-collection",
        "among": "product",
        "weight": 1
      },
      {
        "type": "shared",
        "kind": "goes-with",
        "among": "product",
        "through": [
          "made-of"
        ],
        "minWeight": 1,
        "min": 2
      },
      {
        "type": "co-occur",
        "kind": "paired",
        "among": "material",
        "through": [
          "made-of"
        ],
        "minWeight": 0.5,
        "min": 2
      },
      {
        "type": "topics",
        "kind": "about",
        "weight": 0.7,
        "topics": [
          {
            "key": "outdoor",
            "label": "Outdoor",
            "pattern": "\\b(garden|patio|outdoor)\\b"
          },
          {
            "key": "kids",
            "label": "Kids",
            "pattern": "\\b(kids?|children|nursery)\\b"
          }
        ]
      },
      {
        "type": "named-in",
        "kind": "mentions",
        "named": [
          "product"
        ],
        "weight": 0.5,
        "minNameLength": 4
      }
    ],
    "match": {
      "typoMinLength": 5,
      "distinctWords": true,
      "partialWords": true,
      "precise": true,
      "notHere": [
        "Glass Table"
      ],
      "notDistinct": [
        "set"
      ]
    },
    "templates": {
      "made-by": {
        "out": "{item} is made by {other}.",
        "in": "{item} makes {other}."
      },
      "in-category": {
        "out": "{item} is in {other}.",
        "in": "{item} has {other}."
      },
      "made-of": {
        "out": "{item} is made of {otherLower}.",
        "in": "{item} goes into {other}."
      },
      "goes-with": "{item} goes with {other}[ (both {via})].",
      "same-collection": "{item} is from the same collection as {other}.",
      "paired": "{item} is often paired with {other}[, as in {via}].",
      "about": "{item} is for {otherLower} too.",
      "mentions": {
        "out": "{item} mentions {other}.",
        "in": "{other} mentions {item}."
      },
      "section": "{item} is popular."
    },
    "next": {
      "sections": {
        "shop": "product",
        "brands": "brand"
      }
    }
  },
