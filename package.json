{
  "name": "pubba",
  "version": "0.1.6",
  "description": "A knowledge-graph engine for showroom sites: related items with reasons, what-next predictions from a visitor's trail, and typo-tolerant matching. Portfolios first.",
  "license": "MIT",
  "author": "Tharindu Athapaththu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tharindu127/pubba.git"
  },
  "homepage": "https://github.com/Tharindu127/pubba#readme",
  "bugs": {
    "url": "https://github.com/Tharindu127/pubba/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./portfolio": {
      "types": "./dist/presets/portfolio.d.ts",
      "default": "./dist/presets/portfolio.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    },
    "./exports": {
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pubba": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "knowledge-graph",
    "portfolio",
    "recommendations",
    "related-items",
    "explainable",
    "fuzzy-search",
    "spreading-activation",
    "showroom"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\"",
    "eval": "node --experimental-strip-types --no-warnings src/cli.ts eval examples/portfolio/pubba.json --queries eval/queries.json --trails eval/trails.json --generated --baseline eval/baseline.json",
    "example": "node --experimental-strip-types --no-warnings examples/portfolio/demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "lint:content": "node --experimental-strip-types --no-warnings src/cli.ts lint examples/portfolio/pubba.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
